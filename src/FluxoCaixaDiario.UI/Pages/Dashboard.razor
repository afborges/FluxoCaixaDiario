@page "/dashboard"
@using System.Globalization
@inject ConsolidadoApiService ConsolidadoService

<PageTitle>Dashboard</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <h2 class="mb-0">📊 Dashboard — Consolidado Diário</h2>
    <div class="ms-auto d-flex gap-2 align-items-center">
        <div class="btn-group btn-group-sm" role="group">
            <button class="btn @(_modoVisualizacao == "tabela" ? "btn-dark" : "btn-outline-dark")" @onclick='() => _modoVisualizacao = "tabela"'>📋 Tabela</button>
            <button class="btn @(_modoVisualizacao == "cards" ? "btn-dark" : "btn-outline-dark")" @onclick='() => _modoVisualizacao = "cards"'>🃏 Cards</button>
        </div>
    </div>
</div>

<!-- Seletor de período -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">📅 Data Início</label>
                <input type="date" class="form-control" @bind="_dataInicio" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">📅 Data Fim</label>
                <input type="date" class="form-control" @bind="_dataFim" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="ConsultarAsync" disabled="@_carregando">
                    @(_carregando ? "⏳ Carregando..." : "🔍 Consultar")
                </button>
            </div>
            <div class="col-md-4 d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => AtalhoAsync(7)'>7 dias</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => AtalhoAsync(15)'>15 dias</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => AtalhoAsync(30)'>30 dias</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="AtalhoMesAtualAsync">Mês atual</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_erro))
{
    <div class="alert alert-danger">
        <strong>❌ Erro:</strong> @_erro
        <br /><small>Verifique se a API de consolidado está em execução.</small>
    </div>
}

@if (_carregando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Carregando consolidado...</p>
    </div>
}
else if (_historico is not null)
{
    <!-- Cards de resumo -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="text-success fs-4 fw-bold">@TotalCreditos.ToString("C2", _ptBR)</div>
                    <div class="text-muted small">💚 Total Créditos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="text-danger fs-4 fw-bold">@TotalDebitos.ToString("C2", _ptBR)</div>
                    <div class="text-muted small">❤️ Total Débitos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="@(SaldoLiquido >= 0 ? "text-primary" : "text-warning") fs-4 fw-bold">@SaldoLiquido.ToString("C2", _ptBR)</div>
                    <div class="text-muted small">@(SaldoLiquido >= 0 ? "📈" : "📉") Saldo Líquido</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="text-secondary fs-4 fw-bold">@TotalLancamentos</div>
                    <div class="text-muted small">📋 Total de Lançamentos</div>
                    <div class="text-muted small">em @_historico.Count dia(s)</div>
                </div>
            </div>
        </div>
    </div>

    @if (!_historico.Any())
    {
        <div class="alert alert-info">Nenhum dado consolidado para o período selecionado.</div>
    }
    else if (_modoVisualizacao == "tabela")
    {
        <!-- Tabela histórica -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <strong>📋 Detalhe por Dia</strong>
                <span class="badge bg-secondary">@_historico.Count dia(s)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Data</th>
                            <th class="text-end">Créditos</th>
                            <th class="text-end">Débitos</th>
                            <th class="text-end">Saldo Final</th>
                            <th class="text-center">Lançamentos</th>
                            <th>Última Atualização</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dia in _historico.OrderByDescending(d => d.Data))
                        {
                            <tr>
                                <td class="fw-bold">@dia.Data.ToString("dd/MM/yyyy")</td>
                                <td class="text-end text-success fw-bold">@dia.TotalCreditos.ToString("C2", _ptBR)</td>
                                <td class="text-end text-danger fw-bold">@dia.TotalDebitos.ToString("C2", _ptBR)</td>
                                <td class="text-end fw-bold @(dia.SaldoFinal >= 0 ? "text-primary" : "text-warning")">
                                    @dia.SaldoFinal.ToString("C2", _ptBR)
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">@dia.QuantidadeLancamentos</span>
                                </td>
                                <td class="text-muted small">@dia.UltimaAtualizacao.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold border-top border-2">
                        <tr>
                            <td>Total do período</td>
                            <td class="text-end text-success">@TotalCreditos.ToString("C2", _ptBR)</td>
                            <td class="text-end text-danger">@TotalDebitos.ToString("C2", _ptBR)</td>
                            <td class="text-end @(SaldoLiquido >= 0 ? "text-primary" : "text-warning")">
                                @SaldoLiquido.ToString("C2", _ptBR)
                            </td>
                            <td class="text-center">@TotalLancamentos</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Modo cards -->
        <div class="row g-3">
            @foreach (var dia in _historico.OrderByDescending(d => d.Data))
            {
                var total = dia.TotalCreditos + dia.TotalDebitos;
                var pctC = total > 0 ? (int)(dia.TotalCreditos / total * 100) : 0;
                var pctD = 100 - pctC;
                var saldoPositivo = dia.SaldoFinal >= 0;
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 @(saldoPositivo ? "border-start border-success border-4" : "border-start border-danger border-4")" style="border-left-width: 4px !important;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold fs-6">📅 @dia.Data.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@dia.Data.ToString("dddd", _ptBR)</div>
                                </div>
                                <span class="badge @(saldoPositivo ? "bg-success" : "bg-danger") fs-6">
                                    @(saldoPositivo ? "+" : "")@dia.SaldoFinal.ToString("C2", _ptBR)
                                </span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6 text-center p-2 rounded" style="background:#f0fdf4">
                                    <div class="text-success fw-bold small">@dia.TotalCreditos.ToString("C2", _ptBR)</div>
                                    <div class="text-muted" style="font-size:0.7rem">💚 Créditos</div>
                                </div>
                                <div class="col-6 text-center p-2 rounded" style="background:#fef2f2">
                                    <div class="text-danger fw-bold small">@dia.TotalDebitos.ToString("C2", _ptBR)</div>
                                    <div class="text-muted" style="font-size:0.7rem">❤️ Débitos</div>
                                </div>
                            </div>

                            @if (total > 0)
                            {
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.7rem">
                                        <span class="text-success">@pctC% crédito</span>
                                        <span class="text-danger">@pctD% débito</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-success" style="width: @pctC%"></div>
                                        <div class="progress-bar bg-danger" style="width: @pctD%"></div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge bg-light text-dark border">@dia.QuantidadeLancamentos lançamento(s)</span>
                                <small class="text-muted" style="font-size:0.65rem">@dia.UltimaAtualizacao.ToString("HH:mm")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private static readonly CultureInfo _ptBR = new("pt-BR");

    private List<ConsolidadoModel>? _historico;
    private bool _carregando;
    private string? _erro;
    private string _modoVisualizacao = "tabela";
    private DateTime _dataInicio = DateTime.Today.AddDays(-29);
    private DateTime _dataFim = DateTime.Today;

    private decimal TotalCreditos => _historico?.Sum(d => d.TotalCreditos) ?? 0;
    private decimal TotalDebitos => _historico?.Sum(d => d.TotalDebitos) ?? 0;
    private decimal SaldoLiquido => _historico?.Sum(d => d.SaldoFinal) ?? 0;
    private int TotalLancamentos => _historico?.Sum(d => d.QuantidadeLancamentos) ?? 0;

    protected override async Task OnInitializedAsync() => await ConsultarAsync();

    private async Task AtalhoAsync(int dias)
    {
        _dataInicio = DateTime.Today.AddDays(-(dias - 1));
        _dataFim = DateTime.Today;
        await ConsultarAsync();
    }

    private async Task AtalhoMesAtualAsync()
    {
        _dataInicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _dataFim = DateTime.Today;
        await ConsultarAsync();
    }

    private async Task ConsultarAsync()
    {
        _carregando = true;
        _erro = null;
        var di = DateOnly.FromDateTime(_dataInicio);
        var df = DateOnly.FromDateTime(_dataFim);
        var (data, erro) = await ConsolidadoService.ObterHistoricoAsync(di, df);
        _historico = data;
        _erro = erro;
        _carregando = false;
    }
}
